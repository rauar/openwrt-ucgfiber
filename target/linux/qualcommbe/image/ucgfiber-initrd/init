#!/bin/sh
export PATH=/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t tmpfs tmpfs /dev
mknod /dev/console c 5 1
mknod /dev/null c 1 3
for n in 0 1 2 3; do mknod /dev/loop$n b 7 $n; done

# create a block node from its sysfs dev file ("major:minor")
mknod_from_sys() {
	[ -e "$2" ] && return 0
	[ -f "$1" ] || return 1
	IFS=: read maj min < "$1"
	mknod "$2" b "$maj" "$min"
}

i=0
while [ $i -lt 20 ] && ! mknod_from_sys /sys/block/mmcblk0/mmcblk0p3/dev /dev/mmcblk0p3; do
	sleep 1
	i=$((i + 1))
done

mkdir -p /mnt/root /mnt/sq
mount -t ext4 -o ro,noload /dev/mmcblk0p3 /mnt/root || { echo "ucgfiber: root partition mount failed"; exec sh; }
for img in rootfs rootfs.bkp; do
	if mount -t squashfs -o ro,loop /mnt/root/$img /mnt/sq; then
		echo "ucgfiber: using $img"
		# rootfs is a file on this partition: keep it mounted inside the new root so sysupgrade can reach it
		mount -o move /mnt/root /mnt/sq/mnt || echo "ucgfiber: could not move the root partition mount"
		exec switch_root /mnt/sq /sbin/init
	fi
done
echo "ucgfiber: no usable rootfs"
exec sh
